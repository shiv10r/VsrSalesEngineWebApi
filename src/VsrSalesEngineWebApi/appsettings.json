{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Features": {
    "AllowDevelopmentGuest": false
  },
  "Jwt": {
    "Issuer": "VsrSalesEngineApi",
    "Audience": "VsrSalesEngineClients",
    "SecretKey": "VsrSalesEngineProductionSecureSecretKeyMustBe32BytesLong!",
    "ExpirationMinutes": 120
  },
  "LLM": {
    "DefaultProvider": "Gemini",
    "Gemini": {
      "Model": "gemini-2.5-flash",
      "ApiKey": ""
    }
  }
}
