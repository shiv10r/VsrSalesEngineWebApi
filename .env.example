# VSR Sales Engine Web API - Environment Configuration Template
# Copy this file to .env or configure in your deployment platform (Render, Supabase)
# NEVER commit production credentials, passwords, or secret keys to source control.

# Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Production

# Supabase / PostgreSQL Connection String
# Port 6543 for transaction pooling, Port 5432 for session/direct
ConnectionStrings__DefaultConnection=Host=aws-0-us-west-1.pooler.supabase.com;Port=6543;Username=postgres.your-project-ref;Password=your-strong-password;Database=postgres;Pooling=true;SSL Mode=Require;Trust Server Certificate=true;

# JWT Authentication
Jwt__Issuer=VsrSalesEngineApi
Jwt__Audience=VsrSalesEngineClients
# Must be at least 32 characters (256-bit) cryptographically random string
Jwt__SecretKey=replace-with-a-cryptographically-secure-random-256-bit-key-min-32-chars

# CORS Allowed Origins (Comma-separated list of frontends)
AllowedOrigins=https://vsrsalesengine.netlify.app,http://localhost:5173,http://127.0.0.1:5173

# Safe Outreach Controls (T050, T055, T069)
# OUTREACH_MODE: 'Test' (Sandbox sink routing) | 'Production' (Direct sending once Gate 7 passed)
OUTREACH_MODE=Test

# Emergency Kill Switch (T069)
# Set to 'true' to immediately halt all outbound outreach dispatching across all services
OUTREACH_KILL_SWITCH=false

# Worker Concurrency & Rate Limiting (T058, T061)
WORKER_CONCURRENCY_LIMIT=1
DEFAULT_HTTP_TIMEOUT_SECONDS=15

# Approved Source Provider API Keys (T022, T064)
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# Transactional Email Provider (T050, T053)
SENDGRID_API_KEY=your-sendgrid-api-key
SINK_NOTIFICATION_EMAIL=dev-sink@vsrsalesengine.local
